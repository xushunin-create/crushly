<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged with the generated Info.plist (GENERATE_INFOPLIST_FILE = YES). See docs/CAMPUS_SPACES_DESIGN.md §2.
     When-In-Use only: there is deliberately no NSLocationAlwaysAndWhenInUseUsageDescription. -->
<plist version="1.0">
<dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Crushly privately checks whether you're in a supported campus space so you can choose to match there. Your precise location is never shown to anyone.</string>
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>CampusMatching</key>
		<string>Approximate location can be off by miles, so Crushly can't tell whether you're in a campus space. Precise location stays on your phone and is never shown to anyone.</string>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<!-- Only used while you've chosen "Open to matching": keeps your 60-second participation renewing with the
		     blue location indicator showing. Stops the moment you go invisible or leave. -->
		<string>location</string>
	</array>
</dict>
</plist>
